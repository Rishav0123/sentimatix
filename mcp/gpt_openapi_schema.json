{
  "openapi": "3.1.0",
  "info": {
    "title": "Sentimatix API",
    "description": "Real-time NSE/BSE Indian stock market news, sentiment analysis and sector intelligence.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://sentimatix-production.up.railway.app/api/v1"
    }
  ],
  "paths": {
    "/news": {
      "get": {
        "operationId": "getNews",
        "summary": "Get latest Indian stock market news with sentiment",
        "description": "Fetch real-time financial news for NSE/BSE stocks, filtered by symbol, sector, sentiment and date range.",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated NSE tickers e.g. RELIANCE,TCS,HDFCBANK",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "sectors",
            "in": "query",
            "description": "Comma-separated sectors e.g. Banking,IT Services,Pharmaceuticals",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "sentiment",
            "in": "query",
            "description": "Filter by sentiment: positive, negative, neutral, conflicted",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["positive", "negative", "neutral", "conflicted"]
            }
          },
          {
            "name": "published_after",
            "in": "query",
            "description": "Only news published after this date (YYYY-MM-DD)",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results to return. Hard-capped at 5 for this analyst view.",
            "required": false,
            "schema": { 
              "type": "integer", 
              "default": 3,
              "maximum": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of news articles with sentiment labels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "properties": {
                        "found": { "type": "integer" },
                        "returned": { "type": "integer" }
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": { "type": "string" },
                          "snippet": { "type": "string" },
                          "url": { "type": "string" },
                          "source": { "type": "string" },
                          "published_at": { "type": "string" },
                          "sentiment": { "type": "string" },
                          "entities": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "symbol": { "type": "string" },
                                "name": { "type": "string" },
                                "sector": { "type": "string" }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [{ "ApiKeyAuth": [] }]
      }
    },
    "/entities": {
      "get": {
        "operationId": "getEntities",
        "summary": "Search NSE/BSE listed stocks",
        "description": "Search for Indian stocks by name, symbol or sector.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search by company name or ticker symbol",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "sector",
            "in": "query",
            "description": "Filter by sector e.g. Banking, IT Services, Pharmaceuticals",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "exchange",
            "in": "query",
            "description": "NSE or BSE",
            "required": false,
            "schema": { "type": "string", "default": "NSE" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of stocks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "name": { "type": "string" },
                          "sector": { "type": "string" },
                          "exchange": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [{ "ApiKeyAuth": [] }]
      }
    },
    "/sentiment/sectors": {
      "get": {
        "operationId": "getSectorSentiment",
        "summary": "Get sector-wide sentiment trends",
        "description": "Returns bullish/bearish sentiment scores aggregated across all stocks in a sector over 7 or 30 days.",
        "parameters": [
          {
            "name": "sectors",
            "in": "query",
            "description": "Comma-separated sectors e.g. Banking,IT Services",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "period",
            "in": "query",
            "description": "7d (last 7 days) or 30d (last 30 days)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["7d", "30d"],
              "default": "7d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sector sentiment breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sector": { "type": "string" },
                          "avg_sentiment_score": { "type": "number" },
                          "sentiment_label": { "type": "string" },
                          "total_articles": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [{ "ApiKeyAuth": [] }]
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your Sentimatix API key as a Bearer token. Get one free at sentimatix.com"
      }
    }
  }
}
